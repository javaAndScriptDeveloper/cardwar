  "sounds": { "lose_money": "sounds/lose_money.wav", "fanfare": "sounds/fanfare.wav" },
  "animations": { "money_rain": { "kind": "css", "className": "fx-money-rain", "durationMs": 1200 } },
  "rules": [
    {
      "id": "banker-beaten",
      "on": "card_beaten",
      "if": { "beaten": { "tag": "banker" } },
      "do": [
        { "sound": "lose_money" },
        { "anim": "money_rain", "target": "beaten" },
        { "bubble": { "uk": "Мінус гроші!" }, "target": "beaten" }
      ],
      "cooldownMs": 4000
    },
    {
      "id": "inseparable",
      "on": "hand_changed",
      "if": { "handHas": ["KING_OF_SPADES", "JACK_OF_SPADES"] },
      "do": [{ "layout": "stick_together", "cards": ["KING_OF_SPADES", "JACK_OF_SPADES"] }]
    },
    {
      "id": "deputy-promises",
      "on": "card_played",
      "if": { "side": "opponent", "card": { "tag": "deputy" } },
      "do": [
        { "anim": "shake", "target": "played" },
        { "bubble": { "uk": "Обіцяю, що це востаннє!" }, "target": "opponent" }
      ],
      "cooldownMs": 6000
    },
    {
      "id": "victory-fanfare",
      "on": "duel_finished",
      "if": { "outcome": "WON" },
      "do": [{ "sound": "fanfare" }, { "haptic": "success" }, { "say": { "uk": "Перемога!" } }]
    }
  ]
}
