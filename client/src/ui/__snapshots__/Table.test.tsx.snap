exports[`Table > renders a stored view deterministically 1`] = `"<section class="table"><header class="opponent"><span class="name">Bob</span><span class="count" data-testid="opponent-count">4</span><div class="fan"><img class="card small" src="/cards/classic/back.svg" alt="Card back" draggable="false"><img class="card small" src="/cards/classic/back.svg" alt="Card back" draggable="false"><img class="card small" src="/cards/classic/back.svg" alt="Card back" draggable="false"><img class="card small" src="/cards/classic/back.svg" alt="Card back" draggable="false"></div></header><div class="felt"><div class="deck"><img class="card small" src="/cards/classic/back.svg" alt="Card back" draggable="false"><span class="count" data-testid="talon-count">12</span><img class="card small trump" src="/cards/classic/ten_of_hearts.svg" alt="Ten of Hearts" draggable="false" data-testid="trump" data-card="TEN_OF_HEARTS"><span class="hint">Trump</span></div><div class="pairs"><button class="pair" aria-label="Seven of Spades, beaten by Eight of Spades" aria-pressed="false" data-attack="SEVEN_OF_SPADES" data-defence="EIGHT_OF_SPADES"><img class="card" src="/cards/classic/seven_of_spades.svg" alt="Seven of Spades" draggable="false"><img class="card defence" src="/cards/classic/eight_of_spades.svg" alt="Eight of Spades" draggable="false"></button><button class="pair" aria-label="Seven of Clubs" aria-pressed="false" data-attack="SEVEN_OF_CLUBS"><img class="card" src="/cards/classic/seven_of_clubs.svg" alt="Seven of Clubs" draggable="false"></button></div><span class="hint discard">Discarded: 6</span></div><p class="status" role="status" data-state="defend">Defend</p><div class="actions"><button data-testid="take">Take</button><button class="primary" data-testid="end-attack" disabled="">End attack</button></div><div class="hand"><button class="hand-card" aria-label="Six of Clubs" data-card="SIX_OF_CLUBS" data-playable="false"><img class="card" src="/cards/classic/six_of_clubs.svg" alt="Six of Clubs" draggable="false"></button><button class="hand-card" aria-label="Nine of Spades" data-card="NINE_OF_SPADES" data-playable="false"><img class="card" src="/cards/classic/nine_of_spades.svg" alt="Nine of Spades" draggable="false"></button><button class="hand-card usable" aria-label="Ace of Hearts" data-card="ACE_OF_HEARTS" data-playable="true"><img class="card" src="/cards/classic/ace_of_hearts.svg" alt="Ace of Hearts" draggable="false"></button></div></section>"`;
