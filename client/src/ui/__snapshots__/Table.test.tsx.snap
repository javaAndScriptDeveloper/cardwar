// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Table > renders a stored view deterministically 1`] = `"<section class="table"><header class="opponent"><span class="avatar initials" style="width: 36px; height: 36px; font-size: 14px;" aria-hidden="true" data-testid="opponent-avatar">B</span><span class="name">Bob</span><span class="count" data-testid="opponent-count">4</span><div class="fan" data-testid="opponent-fan" data-back="classic"><img class="card small" src="/cards/classic/back.svg" alt="Сорочка карти" draggable="false" data-back="classic"><img class="card small" src="/cards/classic/back.svg" alt="Сорочка карти" draggable="false" data-back="classic"><img class="card small" src="/cards/classic/back.svg" alt="Сорочка карти" draggable="false" data-back="classic"><img class="card small" src="/cards/classic/back.svg" alt="Сорочка карти" draggable="false" data-back="classic"></div></header><div class="felt table-green" data-testid="felt" data-table="green"><div class="deck" data-testid="talon" data-back="classic"><img class="card small" src="/cards/classic/back.svg" alt="Сорочка карти" draggable="false" data-back="classic"><span class="count" data-testid="talon-count">12</span><img class="card small trump" src="/cards/classic/ten_of_hearts.svg" alt="Десятка чирв" draggable="false" data-testid="trump" data-card="TEN_OF_HEARTS" data-suit="HEARTS"><span class="hint">Козир</span></div><div class="pairs" data-testid="pairs"><button class="pair" aria-label="Сімка пік, побита: Вісімка пік" aria-pressed="false" data-attack="SEVEN_OF_SPADES" data-defence="EIGHT_OF_SPADES"><img class="card" src="/cards/classic/seven_of_spades.svg" alt="Сімка пік" draggable="false"><img class="card defence" src="/cards/classic/eight_of_spades.svg" alt="Вісімка пік" draggable="false"></button><button class="pair" aria-label="Сімка треф" aria-pressed="false" data-attack="SEVEN_OF_CLUBS"><img class="card" src="/cards/classic/seven_of_clubs.svg" alt="Сімка треф" draggable="false"></button></div><span class="hint discard">Відбій: 6</span></div><p class="status" role="status" data-state="defend">Відбивайся</p><div class="actions"><button data-testid="take">Беру</button><button class="primary" data-testid="end-attack" data-idle="" disabled="">Бито</button></div><footer class="you"><span class="avatar initials" style="width: 28px; height: 28px; font-size: 11px;" aria-hidden="true" data-testid="you-avatar">Я</span><span class="name">Я</span><span class="count">3</span></footer><div class="hand" data-testid="hand" style="--cards: 3;"><button class="hand-card" aria-label="Шістка треф" data-card="SIX_OF_CLUBS" data-playable="false"><img class="card" src="/cards/classic/six_of_clubs.svg" alt="Шістка треф" draggable="false"></button><button class="hand-card" aria-label="Дев’ятка пік" data-card="NINE_OF_SPADES" data-playable="false"><img class="card" src="/cards/classic/nine_of_spades.svg" alt="Дев’ятка пік" draggable="false"></button><button class="hand-card usable" aria-label="Туз чирв" data-card="ACE_OF_HEARTS" data-playable="true"><img class="card" src="/cards/classic/ace_of_hearts.svg" alt="Туз чирв" draggable="false"></button></div></section>"`;
