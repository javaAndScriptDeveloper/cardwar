{
  "name": "cardwar-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run packs:check && tsc --noEmit && vite build",
    "packs:check": "node scripts/packs-check.mjs",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "gen:cards": "node scripts/gen-cards.mjs",
    "e2e": "playwright test",
    "gen:sounds": "node scripts/gen-sounds.mjs",
    "gen:pack:memes": "node scripts/gen-pack-memes.mjs",
    "gen:pack:satire": "node scripts/gen-pack-satire.mjs",
    "gen:music": "node scripts/gen-music.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
