# Copy to `.env` and adjust. Loaded by docker compose (`make up`) and can be sourced for local runs.
# `.env` is gitignored; this example is committed. Every value here is a non-production placeholder.

# --- Application ---
APP_NAME=cardwar
SERVER_PORT=8080

# --- Reverse proxy (the only published ports in the full stack) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Postgres (shared by the `db` and `app` compose services) ---
POSTGRES_DB=cardwar
POSTGRES_USER=cardwar
POSTGRES_PASSWORD=change-me-postgres
# Loopback-only host port for local development (docker-compose.override.yml). Not used by `make up`.
DB_PORT=5432

# --- Redis (in-progress duel state and the event channel) ---
# Required by every Redis command; the container refuses to start without it.
REDIS_PASSWORD=change-me-redis
# Loopback-only host port for local development (docker-compose.override.yml). Not used by `make up`.
REDIS_PORT=6379

# --- Authentication ---
# HS256 signing secret, base64, at least 32 bytes once decoded. Generate a real one with:
#   openssl rand -base64 48
# The prod profile refuses to start when this is empty; there is deliberately no built-in default.
JWT_SECRET=ZGV2LW9ubHktY2hhbmdlLW1lLWRldi1vbmx5LWNoYW5nZS1tZS1kZXYtb25seQ==
# Token lifetime. Tokens cannot be revoked before expiry, so keep this short.
JWT_TTL=2h

# --- Duels ---
# How long an in-progress duel survives without a move before Redis drops it. Refreshed on every accepted move.
DUEL_STATE_TTL=2h
# How long a shared duel invite stays acceptable.
DUEL_INVITE_TTL=15m

# --- Telegram / public host ---
# Public hostname nginx serves; used by `make certs-prod` and the Mini App URL registered with BotFather.
DOMAIN=localhost
# Bot token from BotFather: the key Telegram signs Mini App initData with. The prod profile (and so `make up`)
# refuses to start without one. The placeholder lets the stack start locally; no Telegram sign-in will verify
# against it, which is fine for the browser dev shim and the smoke test.
TELEGRAM_BOT_TOKEN=000000000:local-placeholder-not-a-real-bot-token
# How long a signed initData stays usable for sign-in.
TELEGRAM_INIT_DATA_MAX_AGE=1h
