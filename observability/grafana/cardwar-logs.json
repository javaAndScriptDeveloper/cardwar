{
  "uid": "cardwar-logs",
  "title": "Cardwar — Logs",
  "tags": [
    "cardwar"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "requestId",
        "label": "requestId",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "search text",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log volume by level",
      "description": "Is the app suddenly logging far more than usual, or more warnings and errors?",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (level) (count_over_time({app=\"cardwar\", service=\"app\"} [$__auto]))",
          "refId": "A",
          "legendFormat": "{{level}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Error lines by service",
      "description": "Which container is logging errors, and since when?",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (service) (count_over_time({app=\"cardwar\", level=\"ERROR\"} [$__auto]))",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "id": 2
    },
    {
      "type": "logs",
      "title": "Errors",
      "description": "What exactly failed? Every ERROR line with its stack trace; copy its requestId into the box above to see the whole request.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{app=\"cardwar\", level=\"ERROR\"}",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "logs",
      "title": "App log (filter by requestId and text)",
      "description": "What did the app do for this request or this search text? Both boxes empty shows everything; the requestId comes from the X-Request-Id response header.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 14
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{app=\"cardwar\", service=\"app\"} | json | requestId=~\"$requestId.*\" |~ \"(?i)$search\"",
          "refId": "A"
        }
      ],
      "id": 4
    }
  ]
}
